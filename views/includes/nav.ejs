<div class="backdrop"></div>
<header class="main-header">
    <a class="main-header__brand" href="/" aria-label="BookShop home">
        <span class="main-header__brand-mark">B</span>
        <span class="main-header__brand-name">BookShop<small>Stories worth finding</small></span>
    </a>

    <button id="side-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation"
        aria-label="Open navigation menu">
        <span class="main-header__menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Menu</span>
    </button>

    <nav class="main-header__nav" aria-label="Main navigation">
        <ul class="main-header__item-list">
            <li class="main-header__item">
                <a class="<%= path === '/' ? 'active' : '' %>" href="/">Shop</a>
            </li>
            <li class="main-header__item">
                <a class="<%= path === '/products' ? 'active' : '' %>" href="/products">Books</a>
            </li>
            <% if (isLoggedIn) { %>
                <li class="main-header__item">
                    <a class="<%= path === '/cart' ? 'active' : '' %>" href="/cart">Cart</a>
                </li>
                <li class="main-header__item">
                    <a class="<%= path === '/orders' ? 'active' : '' %>" href="/orders">Orders</a>
                </li>
                <li class="main-header__item">
                    <a class="<%= path === '/admin/products' ? 'active' : '' %>" href="/admin/products">My Books</a>
                </li>
            <% } %>
        </ul>

        <div class="main-header__actions">
            <% if (isLoggedIn) { %>
                <a class="main-header__add" href="/admin/add-product">Add a book</a>
                <form action="/logout" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="main-header__logout" type="submit">Logout</button>
                </form>
            <% } else { %>
                <a class="main-header__login <%= path === '/login' ? 'active' : '' %>" href="/login">Log in</a>
                <a class="main-header__signup" href="/signup">Sign up</a>
            <% } %>
        </div>
    </nav>
</header>

<nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" aria-hidden="true">
    <div class="mobile-nav__header">
        <a class="main-header__brand" href="/" aria-label="BookShop home">
            <span class="main-header__brand-mark">B</span>
            <span class="main-header__brand-name">BookShop<small>Stories worth finding</small></span>
        </a>
        <button class="mobile-nav__close" id="mobile-nav-close" type="button" aria-label="Close navigation menu">&times;</button>
    </div>
    <p class="mobile-nav__label">Explore</p>
    <ul class="mobile-nav__item-list">
        <li class="mobile-nav__item">
            <a class="<%= path === '/' ? 'active' : '' %>" href="/">Shop</a>
        </li>
        <li class="mobile-nav__item">
            <a class="<%= path === '/products' ? 'active' : '' %>" href="/products">Books</a>
        </li>
        <% if (isLoggedIn) { %>
            <li class="mobile-nav__item">
                <a class="<%= path === '/cart' ? 'active' : '' %>" href="/cart">Cart</a>
            </li>
            <li class="mobile-nav__item">
                <a class="<%= path === '/orders' ? 'active' : '' %>" href="/orders">Orders</a>
            </li>
            <li class="mobile-nav__item">
                <a class="<%= path === '/admin/products' ? 'active' : '' %>" href="/admin/products">My Books</a>
            </li>
            <li class="mobile-nav__item">
                <a class="<%= path === '/admin/add-product' ? 'active' : '' %>" href="/admin/add-product">Add a book</a>
            </li>
            <li class="mobile-nav__item mobile-nav__item--account">
                <form action="/logout" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Logout</button>
                </form>
            </li>
        <% } else { %>
            <li class="mobile-nav__item mobile-nav__item--account">
                <a class="<%= path === '/login' ? 'active' : '' %>" href="/login">Log in</a>
            </li>
            <li class="mobile-nav__item">
                <a class="mobile-nav__signup" href="/signup">Create an account</a>
            </li>
        <% } %>
    </ul>
</nav>
