<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
    </head>

    <body>
        <%- include('../includes/nav.ejs') %>
            <main class="auth-page">
                <section class="auth-layout">
                    <aside class="auth-aside">
                        <a class="auth-brand" href="/" aria-label="BookShop home">
                            <span class="auth-brand__mark">B</span>
                            <span>BookShop</span>
                        </a>
                        <div class="auth-aside__copy">
                            <p class="auth-aside__eyebrow">A world between the covers</p>
                            <h1>Good to have you back.</h1>
                            <p>Pick up where you left off and find your next great read.</p>
                        </div>
                        <div class="auth-book-art" aria-hidden="true">
                            <span class="auth-book auth-book--one"></span>
                            <span class="auth-book auth-book--two"></span>
                            <span class="auth-book auth-book--three"></span>
                            <span class="auth-book-art__sparkle">✦</span>
                        </div>
                        <p class="auth-aside__footer">Find a story that stays with you.</p>
                    </aside>

                    <div class="auth-card">
                        <header class="auth-card__header">
                            <p class="auth-card__eyebrow">Your reading journey</p>
                            <h2>Welcome back</h2>
                            <p>Sign in to continue to your BookShop account.</p>
                        </header>

                        <% if (errorMessage && errorMessage.length > 0) { %>
                            <div class="flash-message auth-error" role="alert">
                                <%= errorMessage %>
                            </div>
                        <% } %>

                        <form class="auth-form" action="/login" method="POST" novalidate>
                            <div class="form-control">
                                <label for="email">Email address</label>
                                <input class="<%= validationErrors.find(e => e.path === 'email') ? 'invalid' : '' %>"
                                    type="email" name="email" id="email" value="<%= oldInput.email %>"
                                    placeholder="you@example.com" autocomplete="email" required>
                            </div>
                            <div class="form-control">
                                <div class="auth-field-label">
                                    <label for="password">Password</label>
                                    <a href="/reset">Forgot password?</a>
                                </div>
                                <input class="<%= validationErrors.find(e => e.path === 'password') ? 'invalid' : '' %>"
                                    type="password" name="password" id="password"
                                    placeholder="Enter your password" autocomplete="current-password" required>
                            </div>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="auth-submit" type="submit">Sign in</button>
                        </form>

                        <p class="auth-card__switch">New to BookShop? <a href="/signup">Create an account</a></p>
                    </div>
                </section>
            </main>
            <script src="/js/main.js"></script>
    </body>

    </html>
