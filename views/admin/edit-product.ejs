<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/product.css">
    </head>

    <body>
        <%- include('../includes/nav.ejs') %>
            <main>
                <% if (errorMessage) { %>
                    <div class="flash-message">
                        <%= errorMessage %>
                    </div>
                    <% } %>
                        <section class="product-editor">
                            <header class="product-editor__header">
                                <div>
                                    <p class="product-editor__eyebrow">Catalog management</p>
                                    <h1><%= editing ? 'Edit product' : 'Add a new product' %></h1>
                                </div>
                                <a href="/admin/products" class="product-editor__back">Back to products</a>
                            </header>

                            <form class="product-form"
                                action="/admin/<% if(editing) { %>edit-product<% } else { %>add-product<% } %>"
                                method="POST" novalidate enctype="multipart/form-data">
                                <div class="product-editor__content">
                                    <div class="product-editor__fields">
                                        <div class="form-control">
                                            <label for="title">Product title</label>
                                            <input
                                                class="<%= validationErrors && validationErrors.find(e => e.path === 'title') ? 'invalid' : '' %>"
                                                type="text" name="title" id="title"
                                                placeholder="Enter a clear product name"
                                                value="<%= oldInput.title %>" required>
                                        </div>

                                        <div class="form-control form-control--price">
                                            <label for="price">Price</label>
                                            <div class="price-input">
                                                <span>$</span>
                                                <input
                                                    class="<%= validationErrors && validationErrors.find(e => e.path === 'price') ? 'invalid' : '' %>"
                                                    type="number" name="price" id="price" step="0.01" min="0.01"
                                                    placeholder="0.00" value="<%= oldInput.price %>" required>
                                            </div>
                                        </div>

                                        <div class="form-control">
                                            <label for="description">Description</label>
                                            <textarea
                                                class="<%= validationErrors && validationErrors.find(e => e.path === 'description') ? 'invalid' : '' %>"
                                                name="description" id="description" rows="7"
                                                placeholder="Describe the book, author, or key details..."
                                                required><%= oldInput.description %></textarea>
                                        </div>
                                    </div>

                                    <aside class="product-editor__media">
                                        <div class="form-control">
                                            <label for="image">Product image</label>
                                            <div class="image-upload">
                                                <img id="product-image-preview"
                                                    src="<%= editing && oldInput.imageUrl ? '/' + oldInput.imageUrl.replace(/\\/g, '/') : '' %>"
                                                    alt="Product preview"
                                                    class="<%= editing && oldInput.imageUrl ? 'is-visible' : '' %>">
                                                <div class="image-upload__placeholder">
                                                    <span>+</span>
                                                    <strong><%= editing ? 'Replace image' : 'Upload image' %></strong>
                                                    <small>PNG, JPG or WEBP</small>
                                                </div>
                                                <input
                                                    class="<%= validationErrors && validationErrors.find(e => e.path === 'image') ? 'invalid' : '' %>"
                                                    type="file" name="image" id="image" accept="image/png,image/jpeg,image/webp">
                                            </div>
                                            <% if (editing) { %>
                                                <p class="image-upload__hint">Leave empty to keep the current image.</p>
                                            <% } %>
                                        </div>
                                    </aside>
                                </div>

                                <% if(editing) { %>
                                    <input type="hidden" name="productId" value="<%= product._id %>">
                                    <% } %>
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <footer class="product-editor__actions">
                                            <a href="/admin/products" class="product-editor__cancel">Cancel</a>
                                            <button class="btn product-editor__submit" type="submit">
                                                <%= editing ? 'Save changes' : 'Publish product' %>
                                            </button>
                                        </footer>
                            </form>
                        </section>
            </main>
            <script src="/js/main.js"></script>
    </body>

    </html>