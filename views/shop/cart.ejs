<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
        <%- include('../includes/nav.ejs') %>
            <main>
                <% if (products.length> 0) { %>
                    <ul class="cart__item-list">
                        <% products.forEach(p=> { %>
                            <li class="cart__item">
                                <div class="cart__product">
                                    <h1 class="cart__product-title">
                                        <%= p.title %>
                                    </h1>
                                    <span class="cart__unit-price">$<%= Number(p.price).toFixed(2) %> each</span>
                                </div>
                                <span class="cart__quantity">Qty <strong>
                                        <%= p.quantity %>
                                    </strong></span>
                                <div class="cart__line-total">
                                    <span>Item total</span>
                                    <strong>$<%= (p.price * p.quantity).toFixed(2) %></strong>
                                </div>
                                <form action="/cart-delete-item" method="POST">
                                    <input type="hidden" value="<%= p._id %>" name="productId">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">            
                                    <button class="btn danger cart__remove" type="submit">Remove</button>
                                </form>
                            </li>
                            <% }) %>
                    </ul>
                    <hr>
                    <div class="cart__summary">
                        <h2>Total: $<%= totalPrice.toFixed(2) %>
                        </h2>
                        <form action="/create-order" method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn"> Order Now! </button>
                        </form>
                    </div>
                    <% } else { %>
                        <h1>No Products in Cart!</h1>
                        <% } %>
            </main>
            <script src="/js/main.js"></script>
    </body>

    </html>