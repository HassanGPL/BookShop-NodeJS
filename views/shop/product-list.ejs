<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css">
    </head>

    <body>
        <%- include('../includes/nav.ejs') %>
            <main>
                <%if(products.length> 0) { %>
                    <div class="catalog-heading catalog-heading--page">
                        <div>
                            <p>Complete collection</p>
                            <h1>All Products</h1>
                        </div>
                        <span><%= totalProducts %> <%= totalProducts === 1 ? 'book' : 'books' %></span>
                    </div>
                    <div class="grid catalog-grid">
                        <% for(let product of products) {%>
                            <article class="card product-item catalog-card">
                                <div class="card__image">
                                    <a href="/products/<%= product._id %>" aria-label="View <%= product.title %>">
                                        <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
                                    </a>
                                </div>
                                <div class="card__content">
                                    <h1 class="product__title">
                                        <a href="/products/<%= product._id %>"><%= product.title %></a>
                                    </h1>
                                    <p class="product__description">
                                        <%= product.description %>
                                    </p>
                                    <h2 class="product__price">$<%= Number(product.price).toFixed(2) %></h2>
                                </div>
                                <div class="card__actions">
                                    <a href="/products/<%= product._id %>" class="catalog-details-btn">Details</a>
                                    <%- include('../includes/add-to-cart.ejs',{product:product}) %>
                                </div>
                            </article>
                            <% } %>
                    </div>
                    <%- include('../includes/pagination.ejs', { currentPage: currentPage, totalPages: totalPages, basePath: '/products' }) %>
                    <% } else { %>
                        <h1>No Products Found!</h1>
                        <% } %>
            </main>
            <script src="/js/main.js"></script>
    </body>

    </html>